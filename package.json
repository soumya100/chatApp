{
  "name": "chatapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test \"tests/**/*.test.cjs\"",
    "typecheck": "tsc --noEmit",
    "test:security": "node --test tests/security-regression.test.cjs tests/source-regression.test.cjs",
    "test:smoke": "node scripts/smoke-test.cjs",
    "test:browser": "node scripts/browser-smoke.cjs",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.cjs",
    "test:all": "yarn test && yarn test:redis && yarn typecheck && yarn lint && yarn build && yarn audit:security",
    "audit:security": "node scripts/audit-dependencies.cjs",
    "test:redis": "node -e \"if (!process.env.REDIS_HOST || process.env.REDIS_INTEGRATION_ALLOW_FLUSHDB !== \\\"1\\\") { console.error(\\\"Set REDIS_HOST and REDIS_INTEGRATION_ALLOW_FLUSHDB=1 for a disposable Redis test instance; these tests run FLUSHDB.\\\"); process.exit(1); }\" && node --test --test-concurrency=1 tests/redis-lua.integration.test.cjs tests/redis-message-scripts.integration.test.cjs",
    "test:events": "node --test tests/event-polls-api.test.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.19",
    "@hookform/resolvers": "^3.3.4",
    "@next-auth/upstash-redis-adapter": "^3.0.4",
    "@tailwindcss/forms": "^0.5.7",
    "@upstash/redis": "^1.28.2",
    "@vercel/blob": "^2.0.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "encoding": "^0.1.13",
    "lucide-react": "^0.316.0",
    "nanoid": "^5.0.5",
    "next": "15.5.29",
    "next-auth": "^4.24.6",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.49.3",
    "react-hot-toast": "^2.4.1",
    "react-loading-skeleton": "^3.4.0",
    "react-textarea-autosize": "^8.5.3",
    "tailwind-merge": "^2.2.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  },
  "resolutions": {
    "uuid": "11.1.1",
    "zod": "4.6.6",
    "postcss": "8.5.33",
    "picomatch": "4.0.7"
  }
}
